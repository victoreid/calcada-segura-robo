<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do botão de parar (vermelho). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/perigo_suave" />
            <corners android:radius="10dp" />
            <stroke
                android:width="3dp"
                android:color="@color/perigo" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/elevado" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="@color/perigo" />
        </shape>
    </item>
</selector>
