<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- O app só funciona em celular com Bluetooth. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <!-- Android 11 ou mais antigo: permissões antigas do Bluetooth (dadas na instalação). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 12 ou mais novo: "Dispositivos próximos", pedida quando o app abre a conexão. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Vibrar quando aparece obstáculo ou buraco. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/TemaRobo">

        <!-- configChanges: trocar o tema escuro ou o teclado não derruba a conexão com o robô. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
