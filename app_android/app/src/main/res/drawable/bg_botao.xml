<?xml version="1.0" encoding="utf-8"?>
<!--
    Fundo dos botões de direção. Vale o primeiro item que combinar:
    pressed   = dedo no botão
    selected  = modo contínuo (âmbar)
    activated = é o movimento atual
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/destaque_suave" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="@color/destaque" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ambar_suave" />
            <corners android:radius="10dp" />
            <stroke
                android:width="3dp"
                android:color="@color/ambar" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ativo" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="@color/destaque" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/elevado" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/linha" />
        </shape>
    </item>
</selector>
